<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Einstein Chatbot</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        h1 {
            color: #333;
        }
        
        /* Chatbot Button Styling */
        .embeddedServiceHelpButton .helpButton .uiButton {
            background-color: #005290 !important;
            font-family: "Arial", sans-serif !important;
        }
        .embeddedServiceHelpButton .helpButton .uiButton:focus {
            outline: 1px solid #005290 !important;
        }
    </style>
</head>
<body>
    <h1>Welcome to Our Website</h1>
    <p>Chat with our Einstein Bot below:</p>

    <!-- Chatbot Script -->
    <script type='text/javascript' src='https://service.force.com/embeddedservice/5.0/esw.min.js'></script>
    <script type='text/javascript'>
        var initESW = function(gslbBaseURL) {
            embedded_svc.settings.displayHelpButton = true; // Show Chatbot Button
            embedded_svc.settings.language = ''; // Set language (e.g., 'en' for English)

            embedded_svc.settings.enabledFeatures = ['LiveAgent'];
            embedded_svc.settings.entryFeature = 'LiveAgent';

            // Initialize Chatbot
            embedded_svc.init(
                'https://gsquaregroup--whatsdigit.sandbox.my.salesforce.com',
                'https://gsquaregroup--whatsdigit.sandbox.my.site.com/',
                gslbBaseURL,
                '00DIp0000000Otz',
                'Website_Chatbot_Queue',
                {
                    baseLiveAgentContentURL: 'https://c.la1-c1cs-it4.salesforceliveagent.com/content',
                    deploymentId: '572Ip000000Gmaa',
                    buttonId: '573Ip000000Gmc7',
                    baseLiveAgentURL: 'https://d.la1-c1cs-it4.salesforceliveagent.com/chat',
                    eswLiveAgentDevName: 'Website_Chatbot_Queue',
                    isOfflineSupportEnabled: false
                }
            );
        };

        // Load Chatbot Script
        if (!window.embedded_svc) {
            var s = document.createElement('script');
            s.setAttribute('src', 'https://gsquaregroup--whatsdigit.sandbox.my.salesforce.com/embeddedservice/5.0/esw.min.js');
            s.onload = function() {
                initESW(null);
            };
            document.body.appendChild(s);
        } else {
            initESW('https://service.force.com');
        }
    </script>
</body>
</html>
